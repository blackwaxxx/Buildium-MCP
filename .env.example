# buildium-mcp credentials.
#
# Prefer your MCP client's own `env` block over this file — the real process
# environment takes priority over every .env location. See the README.
#
# Sandbox is a SEPARATE Buildium account from production; production keys do
# not authenticate against apisandbox.buildium.com.

BUILDIUM_CLIENT_ID=
BUILDIUM_CLIENT_SECRET=

# Sandbox is the default; set this only to target production.
# BUILDIUM_BASE_URL=https://apisandbox.buildium.com

# sandbox | production-readonly | production-readonly-files | production-write
# Defaults to sandbox. Reaching production needs BOTH this and a production
# BUILDIUM_BASE_URL — neither alone is enough.
# BUILDIUM_DEPLOYMENT_MODE=sandbox

# fixtures (default) | open
# BUILDIUM_WRITE_MODE=fixtures
